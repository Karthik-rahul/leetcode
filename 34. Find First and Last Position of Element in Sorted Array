class Solution {
    public int[] searchRange(int[] nums, int target) {
        int i=0;
        int j=nums.length-1;
        while((i<=j) && (nums[i]!=target)){
            i++;
        }
        while((j>=i)&&(nums[j]!=target)){
            j--;
        }
        if(i>j){
            return new int[]{-1,-1};
        }
        else{
            return new int[]{i,j};
        }

       
    }
}
